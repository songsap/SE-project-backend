{
	"info": {
		"name": "Haroii API Tests",
		"description": "API testing collection for Haroii backend",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://se-project-backend-e7k3.vercel.app/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "restaurant_slug",
			"value": "oasis-1",
			"type": "string"
		}
