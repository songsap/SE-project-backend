		{
			"name": "Table Sessions",
			"item": [
				{
					"name": "Open Table Session",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('table_session_id', jsonData.sessionId);",
									"    console.log('Table session ID:', jsonData.sessionId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantSlug\": \"{{restaurant_slug}}\",\n  \"tableNo\": \"1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/table-sessions/open",
							"host": ["{{base_url}}"],
							"path": ["table-sessions", "open"]
						}
					},
					"response": []
				},
				{
					"name": "Close Table Session",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/table-sessions/:sessionId/close",
							"host": ["{{base_url}}"],
							"path": ["table-sessions", ":sessionId", "close"],
							"variable": [
								{
									"key": "sessionId",
									"value": "{{table_session_id}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
